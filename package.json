{
  "name": "node-red-contrib-anker-solix",
  "version": "1.1.1",
  "description": "Node-RED nodes to read real-time data, AC charging & energy statistics and control usage modes for Anker SOLIX Solar & Energy Storage Systems (Solarbank 1/2/3 Pro/4 E5000 Pro AE103, SOLIX E10, Power Dock AE100, Smart Meter) for OpenCCU, MQTT, Home Assistant, ioBroker, InfluxDB and KNX/Loxone.",
  "main": "anker-solix.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "node-red": {
    "version": ">=2.0.0",
    "nodes": {
      "anker-solix": "anker-solix.js",
      "anker-solix-config": "anker-solix-config.js",
      "anker-solix-control": "anker-solix-control.js"
    }
  },
  "keywords": [
    "node-red",
    "anker",
    "anker-solix",
    "solix",
    "solarbank",
    "solarbank-2",
