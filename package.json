    "solarbank-4",
    "ae103",
    "solix-e10",
    "solarbank-max",
    "power-dock",
    "ae100",
    "smart-meter",
    "solar",
    "battery",
    "energy-storage",
    "openccu",
    "homematic",
    "redmatic",
    "mqtt",
    "home-assistant",
    "iobroker",
    "influxdb",
    "knx",
    "loxone",
    "smart-home"
  ],
  "repository": "github:j-c-wegner/node-red-contrib-anker-solix",
  "bugs": "j-c-wegner/node-red-contrib-anker-solix",
  "homepage": "github:j-c-wegner/node-red-contrib-anker-solix",
