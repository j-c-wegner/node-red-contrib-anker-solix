    "solarbank-max",
    "power-dock",
    "ae100",
    "smart-meter",
    "solar",
    "battery",
    "energy-storage",
    "openccu",
    "homematic",
    "redmatic",
    "mqtt",
    "home-assistant",
    "iobroker",
    "influxdb",
    "knx",
    "loxone",
    "smart-home"
  ],
  "author": {
    "name": "John"
  },
  "license": "MIT",
